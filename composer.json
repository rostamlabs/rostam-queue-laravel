{
    "name": "rostamlabs/rostam-queue-laravel",
    "description": "A Laravel queue driver for Rostam - at-least-once delivery on the key-value engine, claiming jobs with leases rather than destructively, over the native binary TCP protocol.",
    "keywords": [
        "laravel",
        "queue",
        "rostam",
        "key-value",
        "driver"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Keivan Sohrabloo",
            "email": "K.sohrabloo.k@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/queue": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "rostamlabs/rostam-client-php": "^0.1"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Rostam\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rostam\\Queue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rostam\\Queue\\RostamQueueServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
